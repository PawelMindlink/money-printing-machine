      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Brand configuration\nconst brand = 'Bushido';\n\n// Business logic config (inline - should match business_logic.json)\nconst config = {\n  'Bushido': { vat: 0.23, default_margin: 0.58, margin_overrides: {'worek': 0.23} },\n  'Iiyama': { vat: 0.23, default_margin: 0.10 },\n  'Koszulkowy': { vat: 0.23, default_margin: 0.45 }\n};\n\n// Tier rules for GA4 Classification\nconst tier_rules = {\n  'star': { revenue_min: 5000, frequency_min: 1.5 },\n  'cash_cow': { revenue_min: 1000, revenue_max: 5000, frequency_min: 1.2, frequency_max: 1.5 },\n  'hidden_gem': { revenue_max: 1000, frequency_min: 1.5 },\n  'slacker': { revenue_max: 1000, frequency_max: 1.2 }\n};\n\nreturn [{ json: { brand, config: config[brand], tier_rules } }];"
      },
      "id": "set-config",
      "name": "Set Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "url": "=https://www.googleapis.com/analytics/v3/management/accounts/~all/webproperties/~all/profiles",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleAnalyticsOAuth2"
      },
      "id": "ga4-api",
      "name": "GA4 API (Optional)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        650,
        200
      ],
      "notes": "Placeholder - use Google Analytics node or HTTP with service account"
    },
    {
      "parameters": {
        "jsCode": "// Simulate pipeline output for now\nconst input = $input.first().json;\nconst brand = input.brand;\n\n// This would normally process actual data\n// For now, return summary structure\nconst summary = {\n  brand,\n  processed_at: new Date().toISOString(),\n  status: 'Simulated - Native JS pipeline ready',\n  note: 'Replace with actual data processing once GA4/Feed data nodes are connected'\n};\n\nreturn [{ json: summary }];"
      },
      "id": "process-data",
      "name": "Process Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        850,
