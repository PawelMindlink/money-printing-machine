    },
    {
      "parameters": {
        "url": "={{ $json[\"FEED_URL\"] }}",
        "method": "GET",
        "responseFormat": "string"
      },
      "name": "Get Product Feed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        650,
        200
      ],
      "id": "f89f47ab-1f84-4417-b920-d90747960571"
    },
    {
      "parameters": {
        "mode": "xml2json",
        "options": {}
      },
      "name": "Parse XML",
      "type": "n8n-nodes-base.xml",
      "typeVersion": 1,
      "position": [
        850,
        200
      ],
      "id": "fba0c479-f6df-405c-a856-7acf52ceabbc"
    },
    {
      "parameters": {
        "functionCode": "// Normalize Feed Data\nconst items = items[0].json.rss.channel.item;\nreturn items.map(item => {\n  const p = {};\n  // Extract fields with namespace handling (naive)\n  p.id = item['g:id'] || item.id;\n  p.title = item['g:title'] || item.title;\n  p.price_raw = item['g:price'] || item.price;\n  p.price = parseFloat((p.price_raw || '0').replace(/[^0-9.]/g, ''));\n  p.link = item['g:link'] || item.link;\n  p.category = item['g:google_product_category'];\n  p.brand = item['g:brand'];\n  \n  // Normalize URL\n  try {\n      const urlObj = new URL(p.link);\n      p.path = urlObj.pathname;\n  } catch(e) { p.path = p.link; }\n  \n  return { json: p };\n});"
      },
      "name": "Normalize Feed",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1050,
        200
      ],
      "id": "298cbfec-22ec-47ce-ab4d-14d1093fca05"
    },
    {
      "parameters": {
        "url": "https://analyticsdata.googleapis.com/v1beta/properties/{{ $node[\"Config\"].json[\"GA4_PROPERTY_ID\"] }}:runReport",
        "method": "POST",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleAnalyticsOAuth2Api",
        "options": {}
      },
      "name": "Get GA4 Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        650,
        400
      ],
      "id": "dedd251c-522a-4a4c-9073-05a2dbc99b1a"
    },
    {
      "parameters": {
        "mode": "mergeByIndex",
        "join": "inner"
      },
      "name": "Merge Feed & GA4",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 1,
      "position": [
        1250,
        300
      ],
      "id": "879c7ec3-1dac-4576-91df-9b940ad59758"
    },
    {
      "parameters": {
        "functionCode": "// Business Logic V4.1\n// 1. Calculate CP\n// 2. Classify (Stars, Cows, Slackers)\n\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n    const data = item.json;\n    \n    // Defaults\n    data.sessions = data.sessions || 0;\n    data.purchases = data.purchases || 0;\n    data.revenue = data.revenue || 0;\n    data.meta_spend = data.meta_spend || 0;\n    \n    // 1. Financials\n    const VAT = 0.23;\n    const MARGIN = 0.15; // Default\n    const revenue_net = data.revenue / (1 + VAT);\n    \n    // Frequency = Purchases / First_Time (fallback to 1)\n    const freq = data.purchases / (data.first_time_purchasers || 1);\n    \n    // CP Formula\n    data.contribution_profit = (revenue_net * MARGIN * freq) - data.meta_spend;\n    \n    // 2. ARPU (Rev / Sessions)\n    data.arpu = data.sessions > 0 ? (data.revenue / data.sessions) : 0;\n    \n    // 3. Classification (Static Thresholds for Demo - normally dynamic)\n    // P75 Thresholds (example)\n    const T_TRANS = 10;\n    const T_ARPU = 5.0;\n    \n    if (data.purchases >= T_TRANS) {\n        if (data.arpu >= T_ARPU) data.class = 'Star';\n        else data.class = 'Cash Cow';\n    } else {\n        if (data.arpu >= T_ARPU) data.class = 'Hidden Gem';\n        else data.class = 'Slacker';\n    }\n    \n    results.push({ json: data });\n}\n\nreturn results;"
      },
      "name": "Business Logic",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1450,
        300
      ],
      "id": "6fd771ab-5a3e-46f1-8955-1297687c0aa0"
    },
    {
      "parameters": {
        "operation": "toFile",
        "fileFormat": "csv",
        "options": {}
      },
      "name": "Generate CSV",
      "type": "n8n-nodes-base.spreadsheetFile",
      "typeVersion": 1,
      "position": [
        1650,
        300
      ],
      "id": "b9ccc994-1657-40d3-9246-9149d8f6c4fe"
    }
  ],
