      "id": "fetch-meta-ads",
      "name": "Fetch Meta Ads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        840,
        900
      ],
      "notes": "Updated to v19.0"
    },
    {
      "parameters": {
        "mode": "combine",
        "mergeByFields": {
          "values": [
            {
              "field1": "feed_id",
              "field2": "itemId"
            }
          ]
        },
        "joinMode": "keepMatches",
        "options": {}
      },
      "id": "join-items",
      "name": "Join Feed + GA4 Items",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        1240,
        400
      ]
    },
    {
      "parameters": {
        "mode": "combine",
        "mergeByFields": {
          "values": [
            {
