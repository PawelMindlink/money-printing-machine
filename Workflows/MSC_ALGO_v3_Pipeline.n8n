  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "formTitle": "Money Printing Machine — Start Pipeline",
        "formDescription": "Configure and run the MSC-ALGO pipeline for any brand.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Brand Name",
              "fieldType": "text",
              "requiredField": true,
              "placeholder": "e.g. Iiyama"
            },
            {
              "fieldLabel": "VAT Rate",
              "fieldType": "number",
              "requiredField": true,
              "placeholder": "0.23"
            },
            {
              "fieldLabel": "Default Margin",
              "fieldType": "number",
              "requiredField": true,
              "placeholder": "0.10"
            },
            {
              "fieldLabel": "Feed URL (XML)",
              "fieldType": "text",
              "requiredField": true,
              "placeholder": "https://example.com/feed.xml"
            },
            {
              "fieldLabel": "Data Sheet URL (Google Sheets)",
              "fieldType": "text",
              "requiredField": true,
              "placeholder": "https://docs.google.com/spreadsheets/d/..."
            }
          ]
        },
        "options": {}
      },
      "id": "form-trigger",
      "name": "Pipeline Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        240,
        400
      ],
      "webhookId": "msc-algo-form",
      "notes": "Formularz startowy. 5 pól: brand, VAT, domyślna marża, URL feedu, URL Google Sheet z zakładkami (margin_rules, ga4_lp, ga4_items, meta_ads)."
    },
    {
      "parameters": {
        "jsCode": "// ============================================================\n// GLOBAL CONFIG BUILDER\n// Parsuje dane z Form Trigger i buduje obiekt konfiguracyjny.\n// Wyciąga Sheet ID z URL Google Sheets.\n// ============================================================\n\nconst formData = $input.first().json;\n\n// Parse Sheet ID from URL\n// https://docs.google.com/spreadsheets/d/1aBcDeFgHiJkLmNoPq/edit#gid=0\nconst sheetUrl = formData['Data Sheet URL (Google Sheets)'] || '';\nconst sheetIdMatch = sheetUrl.match(/\\/d\\/([a-zA-Z0-9_-]+)/);\nconst sheetId = sheetIdMatch ? sheetIdMatch[1] : '';\n\nif (!sheetId) {\n  throw new Error('Invalid Google Sheet URL. Expected format: https://docs.google.com/spreadsheets/d/SHEET_ID/edit');\n}\n\nreturn [{\n  json: {\n    BRAND: formData['Brand Name'] || 'Unknown',\n    VAT_RATE: parseFloat(formData['VAT Rate']) || 0.23,\n    DEFAULT_MARGIN: parseFloat(formData['Default Margin']) || 0.10,\n    FEED_URL: formData['Feed URL (XML)'] || '',\n    SHEET_ID: sheetId,\n    SHEET_URL: sheetUrl,\n    \n    // Progi MSC-ALGO (stałe — nie zmieniają się per brand)\n    MSC_ALGO: {\n      MIN_META_TRANS: 10,\n      MIN_ORGANIC_SESSIONS: 300,\n      P75_METHOD: 'quantile'\n    },\n    \n    _generated_at: new Date().toISOString(),\n    _config_version: '5.0'\n  }\n}];"
      },
      "id": "config-builder",
      "name": "Build Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        400
      ],
      "notes": "Parsuje formularz. Wyciąga SHEET_ID z URL. Buduje obiekt konfiguracyjny."
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.SHEET_ID }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "margin_rules"
        },
        "options": {
          "range": "",
          "headerRow": 1
        }
      },
      "id": "read-margin-rules",
      "name": "Read Margin Rules",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        660,
        300
      ],
      "notes": "Czyta zakładkę 'margin_rules' z Google Sheet. Kolumny: match_type, match_value, margin_rate, note."
    },
    {
      "parameters": {
        "jsCode": "// ============================================================\n// MARGIN RESOLVER — 4-Tier MECE Cascade\n//\n// Input 1: Margin rules from Google Sheet (Read Margin Rules)\n// Input 2: Config object (Build Config) — via $node reference\n//\n// Outputs a function-ready config object with margin rules\n// that downstream nodes (MSC-ALGO Logic) will use.\n//\n// Priority Cascade:\n//   P1: SKU_EXACT   — exact match on feed_id\n//   P2: CATEGORY_EXACT — exact match on feed_category (case-insensitive)\n//   P3: KEYWORD     — contains match on feed_category ONLY (not title)\n//   P4: DEFAULT     — fallback from form\n// ============================================================\n\nconst rules = $input.all().map(item => ({\n  match_type:  (item.json.match_type  || '').toUpperCase().trim(),\n  match_value: (item.json.match_value || '').trim(),\n  margin_rate: parseFloat(item.json.margin_rate) || 0,\n  note:        item.json.note || ''\n}));\n\n// Validate rules\nconst validTypes = ['SKU_EXACT', 'CATEGORY_EXACT', 'KEYWORD'];\nconst validRules = rules.filter(r => validTypes.includes(r.match_type) && r.margin_rate > 0);\nconst invalidRules = rules.filter(r => !validTypes.includes(r.match_type) && r.match_type !== '');\n\nif (invalidRules.length > 0) {\n  console.log('WARNING: Invalid rule types found:', invalidRules.map(r => r.match_type));\n}\n\n// Sort by priority: SKU_EXACT first, then CATEGORY_EXACT, then KEYWORD\nconst priorityOrder = { 'SKU_EXACT': 1, 'CATEGORY_EXACT': 2, 'KEYWORD': 3 };\nvalidRules.sort((a, b) => (priorityOrder[a.match_type] || 99) - (priorityOrder[b.match_type] || 99));\n\n// Get config from upstream node\nconst config = $node['Build Config'].json;\n\nreturn [{\n  json: {\n    ...config,\n    MARGIN_RULES: validRules,\n    MARGIN_RULES_COUNT: validRules.length,\n    _margin_resolver_version: '1.0'\n  }\n}];"
      },
      "id": "margin-resolver",
      "name": "Margin Resolver",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        300
      ],
      "notes": "Sortuje reguły marżowe wg priorytetu (SKU > Category > Keyword). Waliduje dane z Sheeta. Przekazuje sorted rules jako MARGIN_RULES do kolejnych nodów."
    },
    {
      "parameters": {
        "url": "={{ $node['Build Config'].json.FEED_URL }}",
        "options": {}
      },
      "id": "fetch-feed",
      "name": "Fetch Product Feed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1060,
        200
      ],
      "notes": "Download XML product feed"
    },
    {
      "parameters": {
        "options": {
          "explicitArray": false,
          "ignoreAttrs": true
        }
      },
      "id": "xml-parser",
      "name": "XML Parser",
      "type": "n8n-nodes-base.xml",
      "typeVersion": 1,
      "position": [
        1260,
        200
      ],
      "notes": "Parse XML to JSON"
    },
    {
      "parameters": {
        "jsCode": "// ============================================================\n// NORMALIZE FEED + RESOLVE MARGINS\n//\n// 1. Extracts products from parsed XML\n// 2. Normalizes URLs\n// 3. Applies Margin Resolver (4-Tier MECE Cascade)\n//\n// Uses MARGIN_RULES from Margin Resolver node.\n// ============================================================\n\n// Get config + margin rules from upstream\nconst config = $node['Margin Resolver'].json;\nconst marginRules = config.MARGIN_RULES || [];\nconst defaultMargin = config.DEFAULT_MARGIN || 0.10;\n\n// Helper: Normalize URL\nfunction normalizeUrl(url) {\n  if (!url) return '';\n  return url.toLowerCase()\n    .replace(/^https?:\\/\\/(www\\.)?/, '')\n    .split('?')[0]\n    .replace(/\\/$/, '');\n}\n\n// Helper: Resolve Margin (4-Tier MECE Cascade)\nfunction resolveMargin(feedId, feedCategory) {\n  const id = (feedId || '').trim();\n  const cat = (feedCategory || '').toLowerCase().trim();\n  \n  // Rules are pre-sorted by priority (SKU_EXACT > CATEGORY_EXACT > KEYWORD)\n  for (const rule of marginRules) {\n    const val = rule.match_value;\n    \n    switch (rule.match_type) {\n      case 'SKU_EXACT':\n        if (id === val) return { rate: rule.margin_rate, matched_rule: `SKU:${val}` };\n        break;\n      case 'CATEGORY_EXACT':\n        if (cat === val.toLowerCase()) return { rate: rule.margin_rate, matched_rule: `CAT:${val}` };\n        break;\n      case 'KEYWORD':\n        if (cat.includes(val.toLowerCase())) return { rate: rule.margin_rate, matched_rule: `KW:${val}` };\n        break;\n    }\n  }\n  \n  return { rate: defaultMargin, matched_rule: 'DEFAULT' };\n}\n\n// Extract products from XML\nconst feedData = $input.first().json;\nlet productList = [];\nif (feedData.rss && feedData.rss.channel && feedData.rss.channel.item) {\n  productList = Array.isArray(feedData.rss.channel.item)\n    ? feedData.rss.channel.item\n    : [feedData.rss.channel.item];\n} else if (feedData.products && feedData.products.product) {\n  productList = Array.isArray(feedData.products.product)\n    ? feedData.products.product\n    : [feedData.products.product];\n}\n\nconst items = productList.map(product => {\n  const priceStr = product.g_price || product.price || '0';\n  const feedId = product.g_id || product.id || '';\n  const feedCategory = product.g_google_product_category || product.google_product_category || product.product_type || '';\n  \n  // Resolve margin using 4-Tier Cascade\n  const { rate, matched_rule } = resolveMargin(feedId, feedCategory);\n  \n  return {\n    json: {\n      feed_id: feedId,\n      feed_title: product.g_title || product.title || '',\n      feed_brand: product.g_brand || product.brand || '',\n      feed_category: feedCategory,\n      feed_link: product.g_link || product.link || '',\n      norm_url: normalizeUrl(product.g_link || product.link),\n      feed_price_numeric: parseFloat(priceStr.replace(/[^0-9.]/g, '')) || 0,\n      \n      // Margin assignment\n      base_gross_margin: rate,\n      margin_matched_rule: matched_rule,\n      \n      // Config passthrough\n      _brand: config.BRAND,\n      _vat_rate: config.VAT_RATE\n    }\n  };\n});\n\nreturn items;"
      },
      "id": "normalize-feed",
      "name": "Normalize Feed + Margins",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1460,
        200
      ],
      "notes": "Parsuje produkty z XML feedu, normalizuje URL, i przypisuje marżę wg 4-Tier MECE Cascade (SKU > Category > Keyword > Default). Każdy produkt dostaje pole 'margin_matched_rule' do audytu."
    },
    {
