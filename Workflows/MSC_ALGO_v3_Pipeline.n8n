        440,
        400
      ],
      "notes": "Load brand configuration"
    },
    {
      "parameters": {
        "url": "={{ 'https://iiyama-sklep.pl/feed_' + $json.brand.toLowerCase() + '.xml' }}",
        "options": {}
      },
      "id": "fetch-feed",
      "name": "Fetch Product Feed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        300
      ],
      "notes": "Download XML product feed"
    },
    {
      "parameters": {
        "options": {
          "explicitArray": false,
          "ignoreAttrs": true
        }
      },
      "id": "xml-parser",
      "name": "XML Parser",
      "type": "n8n-nodes-base.xml",
      "typeVersion": 1,
      "position": [
        840,
        300
      ],
      "notes": "Parse XML to JSON"
    },
    {
      "parameters": {
        "jsCode": "// Extract products and normalize URLs\nconst items = [];\n// XML parser output structure varies, assuming root.products.product or similar\n// Check input structure in N8N execution data\nconst feedData = $input.first().json;\n\n// Helper: Normalize URL\nfunction normalizeUrl(url) {\n  if (!url) return '';\n  return url.toLowerCase()\n    .replace(/^https?:\\/\\/(www\\.)?/, '')\n    .split('?')[0]\n    .replace(/\\/$/, '');\n}\n\n// Determine where product list is (adjust based on actual XML structure)\nlet productList = [];\nif (feedData.rss && feedData.rss.channel && feedData.rss.channel.item) {\n    productList = Array.isArray(feedData.rss.channel.item) ? feedData.rss.channel.item : [feedData.rss.channel.item];\n} else if (feedData.products && feedData.products.product) {\n    productList = Array.isArray(feedData.products.product) ? feedData.products.product : [feedData.products.product];\n}\n\nfor (const product of productList) {\n  const priceStr = product.g_price || product.price || '0';\n  items.push({\n    feed_id: product.g_id || product.id,\n    feed_title: product.g_title || product.title,\n    feed_brand: product.g_brand || product.brand,\n    feed_category: product.g_google_product_category || product.google_product_category,\n    feed_link: product.g_link || product.link,\n    norm_url: normalizeUrl(product.g_link || product.link),\n    feed_price_numeric: parseFloat(priceStr.replace(/[^0-9.]/g, '')),\n    json: product // Keep original for debugging\n  });\n}\n\nreturn items.map(item => ({ json: item }));"
      },
      "id": "normalize-feed",
      "name": "Normalize Feed Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        300
      ]
    },
    {
      "parameters": {
        "authentication": "serviceAccount",
        "propertyId": "={{ $node['Load Config'].json.ga4_property_id }}",
