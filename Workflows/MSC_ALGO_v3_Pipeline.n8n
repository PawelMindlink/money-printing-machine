              "field2": "website_url_normalized"
            }
          ]
        },
        "joinMode": "keepEverything",
        "options": {}
      },
      "id": "join-meta",
      "name": "Join + Meta Ads",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        1440,
        500
      ],
      "notes": "Outer Join"
    },
    {
      "parameters": {
        "jsCode": "// Generate path_key from norm_url\nconst items = $input.all();\nreturn items.map(item => {\n  const row = item.json;\n  if (!row.path_key && row.norm_url) {\n    // Extract path: iiyama.pl/foo/bar -> /foo/bar\n    // Simple heuristic: find first slash\n    const parts = row.norm_url.split('/');\n    if (parts.length > 1) {\n      row.path_key = '/' + parts.slice(1).join('/');\n    } else {\n       row.path_key = '/'; // Homepage fallback\n    }\n  }\n  return item;\n});"
      },
      "id": "backfill-keys",
      "name": "Backfill Path Keys",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1640,
        500
      ]
    },
    {
      "parameters": {
        "mode": "combine",
        "mergeByFields": {
          "values": [
            {
              "field1": "path_key",
              "field2": "landingPagePath"
            }
          ]
        },
        "joinMode": "enrichInput1",
        "options": {}
      },
      "id": "join-lp",
      "name": "Join + GA4 LP",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        1840,
        500
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst VAT = 0.23;\n\n// --- CONFIG ---\n// (In real N8N, pass these via flow variables)\nconst defaultMargin = 0.10;\nconst MIN_ORGANIC_SESSIONS = 300;\n\n// --- HELPERS ---\nfunction getP75(values) {\n  const filtered = values.filter(v => typeof v === 'number' && v > 0).sort((a, b) => a - b);\n  if (filtered.length === 0) return 1.0; // Min threshold\n  const idx = Math.floor(filtered.length * 0.75);\n  return Math.max(1.0, filtered[idx]);\n}\n\n// --- PRE-CALC THRESHOLDS ---\nconst P75_VOL_META = getP75(items.map(i => i.json.meta_revenue || 0));\nconst P75_EFF_META = getP75(items.map(i => i.json.calc_contribution_profit || 0));\nconst P75_VOL_GA = getP75(items.map(i => i.json.sessions || 0));\n// GPPS calculation is per-row, so P75_EFF_GA needs GPPS array\n// First pass calculation needed for proper P75... strict N8N usually does set nodes\n// For simplicity in this Code node, we'll do two passes.\n\n// PASS 1: Basic Metrics\nitems.forEach(item => {\n    const row = item.json;\n    row.calc_entity_type = row.feed_id ? 'PRODUCT' : 'CATEGORY';\n    row.is_product = row.calc_entity_type === 'PRODUCT';\n    \n    // Margin Logic\n    const baseMargin = row.is_product ? defaultMargin : 0.10; // Simple fallback\n    row.base_gross_margin = baseMargin;\n    \n    // GPPS\n    const lpRev = (row.totalRevenue || 0) / (1 + VAT);\n    const lpGP = lpRev * baseMargin;\n    row.calc_gpps = (row.sessions || 0) > 0 ? lpGP / row.sessions : 0;\n    \n    // CP\n    const metaRev = (row.purchase_value || 0) / (1 + VAT);\n    const metaGP = metaRev * baseMargin;\n    row.calc_contribution_profit = metaGP - (row.spend || 0);\n});\n\nconst P75_EFF_GA = getP75(items.map(i => i.json.calc_gpps || 0));\n\n// PASS 2: Waterfall Logic\nfunction runMscAlgo(row) {\n    const flags = [];\n    \n    // Meta Check\n    const metaPurch = row.purchases || 0;\n    if (metaPurch >= 10) {\n        if (row.calc_contribution_profit > 0) {\n            if ((row.purchase_value || 0) >= P75_VOL_META && row.calc_contribution_profit >= P75_EFF_META) {\n                return [1, 'PROVEN_STAR', 'High ad rev + profit'];\n            }\n            return [2, 'PROVEN_COW', 'Profitable, moderate scale'];\n        }\n        flags.push('META_LOSER');\n    }\n    \n    // GA4 LP Check\n    const sessions = row.sessions || 0;\n    if (sessions >= MIN_ORGANIC_SESSIONS) {\n        const isHighVol = sessions >= P75_VOL_GA;\n        const isHighEff = row.calc_gpps >= P75_EFF_GA;\n        \n        if (isHighVol && isHighEff) {\n             if (flags.includes('META_LOSER')) return [3, 'RECOVERY_LAUNCH', 'High organic, fix ads'];\n             return [3, 'NEW_STAR_LAUNCH', 'High organic, untapped'];\n        }\n        if (isHighVol && !isHighEff) return [4, 'FIX_LANDING_PAGE', 'High traffic, low conv'];\n        if (!isHighVol && isHighEff) return [5, 'SCALE_UP', 'Good CR, needs traffic'];\n    }\n    \n    // GA4 Item Check (Products only)\n    if (row.is_product) {\n        // Skipping specific logic for brevity, defaulting to IGNORE if no signal\n        return [8, 'IGNORE', 'Non-product/Insufficient data'];\n    }\n    \n    return [8, 'IGNORE', 'Low signal'];\n}\n\nitems.forEach(item => {\n    const [p, s, r] = runMscAlgo(item.json);\n    item.json.calc_priority = p;\n    item.json.calc_segment = s;\n    item.json.calc_reason = r;\n    item.json.calc_is_actionable = p <= 7;\n});\n\nreturn items;"
      },
      "id": "msc-algo-logic",
      "name": "MSC-ALGO Logic",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2040,
        500
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.calc_is_actionable }}",
              "value2": true
            }
          ]
        }
      },
      "id": "filter-actionable",
      "name": "Filter Actionable",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        2240,
        500
      ]
    },
    {
      "parameters": {
        "operation": "create",
        "fileContent": "={{ JSON.stringify($input.all().map(i => i.json), null, 2) }}",
        "fileName": "Growth_Opportunities.csv",
        "options": {}
      },
      "id": "save-csv",
      "name": "Save CSV",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        2440,
        500
      ]
    }
