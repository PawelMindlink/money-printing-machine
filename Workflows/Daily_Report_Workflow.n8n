  "id": "PeqoqExvdvxhdHZd",
  "name": "Daily Report - Complete Pipeline",
  "active": false,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * *"
            }
          ]
        }
      },
      "id": "schedule-trigger-id",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300],
      "notes": "Runs daily at 06:00 AM"
    },
    {
      "parameters": {
        "command": "python c:/Users/Paweł/Documents/GitHub/Money\\ Printing\\ Machine/src/join_logic_final.py"
      },
      "id": "execute-python-id",
      "name": "Run Python Script",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [450, 300],
      "notes": "Executes join_logic_final.py which: 1) Reads local CSV files, 2) Normalizes URLs, 3) Joins Meta+Feed, 4) Calculates CP with category margins, 5) Saves Landing_Page_Report.csv"
    },
    {
      "parameters": {
        "filePath": "={{ 'c:/Users/Paweł/Documents/GitHub/Money Printing Machine/Output/' + $json.brand + '/Landing_Page_Report.csv' }}",
        "options": {}
      },
      "id": "read-output-id",
      "name": "Read Output Report",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [650, 300],
      "notes": "Reads generated Landing_Page_Report.csv for further processing"
    },
    {
      "parameters": {
        "jsCode": "// Parse CSV and generate summary\nconst brands = ['Bushido', 'Iiyama', 'Koszulkowy'];\nconst results = [];\n\nfor (const brand of brands) {\n  try {\n    const fs = require('fs');\n    const path = `c:/Users/Paweł/Documents/GitHub/Money Printing Machine/Output/${brand}/Landing_Page_Report.csv`;\n    \n    if (!fs.existsSync(path)) {\n      results.push({ brand, status: 'MISSING', error: 'Report not generated' });\n      continue;\n    }\n    \n    const content = fs.readFileSync(path, 'utf-8');\n    const lines = content.split('\\n').filter(l => l.trim());\n    \n    const lp_count = lines.length - 1; // Exclude header\n    \n    results.push({\n      brand,\n      status: 'SUCCESS',\n      landing_pages_processed: lp_count,\n      report_path: path,\n      timestamp: new Date().toISOString()\n    });\n  } catch (error) {\n    results.push({ brand, status: 'ERROR', error: error.message });\n  }\n}\n\nreturn [{ json: { brands: results, total_brands: brands.length, timestamp: new Date().toISOString() } }];"
      },
      "id": "summary-node-id",
      "name": "Generate Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 300],
      "notes": "Generates summary of processed landing pages per brand"
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Run Python Script",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Python Script": {
