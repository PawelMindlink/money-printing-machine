  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * *"
            }
          ]
        }
      },
      "id": "schedule-trigger-id",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300],
      "notes": "Runs daily at 06:00 AM"
    },
    {
      "parameters": {
        "jsCode": "// Set brand to process\nconst brands = ['Bushido', 'Iiyama', 'Koszulkowy'];\nreturn brands.map(brand => ({ json: { brand } }));"
      },
      "id": "set-brands-id",
      "name": "Set Brands",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300],
      "notes": "Outputs list of brands to process"
    },
    {
      "parameters": {
        "command": "={{ 'python \"c:/Users/Paweł/Documents/GitHub/Money Printing Machine/src/complete_pipeline.py\" ' + $json.brand }}"
      },
      "id": "execute-pipeline-id",
      "name": "Run Complete Pipeline",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [650, 300],
      "notes": "Runs complete_pipeline.py for each brand: 1) Load GA4 LP, 2) Join Product Feed by path, 3) Enrich with Items, 4) Join Meta Ads, 5) Calculate CP & Priority"
    },
    {
      "parameters": {
        "jsCode": "// Read and verify output files\nconst brand = $json.brand;\nconst fs = require('fs');\n\nconst mainPath = `c:/Users/Paweł/Documents/GitHub/Money Printing Machine/Output/${brand}/Landing_Page_Final.csv`;\nconst skipPath = `c:/Users/Paweł/Documents/GitHub/Money Printing Machine/Output/${brand}/Produkty_Pominięte.csv`;\n\ntry {\n  const mainExists = fs.existsSync(mainPath);\n  const skipExists = fs.existsSync(skipPath);\n  \n  let mainCount = 0, skipCount = 0;\n  \n  if (mainExists) {\n    const content = fs.readFileSync(mainPath, 'utf-8');\n    mainCount = content.split('\\n').filter(l => l.trim()).length - 1;\n  }\n  \n  if (skipExists) {\n    const content = fs.readFileSync(skipPath, 'utf-8');\n    skipCount = content.split('\\n').filter(l => l.trim()).length - 1;\n  }\n  \n  return [{\n    json: {\n      brand,\n      status: 'SUCCESS',\n      landing_pages: mainCount,\n      skipped_products: skipCount,\n      timestamp: new Date().toISOString()\n    }\n  }];\n} catch (error) {\n  return [{ json: { brand, status: 'ERROR', error: error.message } }];\n}"
      },
      "id": "verify-output-id",
      "name": "Verify Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 300],
      "notes": "Verifies output files exist and counts products"
    },
    {
      "parameters": {
        "jsCode": "// Aggregate results from all brands\nconst items = $input.all();\nconst results = items.map(item => item.json);\n\nconst summary = {\n  total_brands: results.length,\n  successful: results.filter(r => r.status === 'SUCCESS').length,\n  failed: results.filter(r => r.status === 'ERROR').length,\n  total_landing_pages: results.reduce((sum, r) => sum + (r.landing_pages || 0), 0),\n  brands: results,\n  timestamp: new Date().toISOString()\n};\n\nreturn [{ json: summary }];"
      },
      "id": "aggregate-summary-id",
      "name": "Aggregate Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1050, 300],
      "notes": "Aggregates results from all brand runs into final summary"
    }
  ],
