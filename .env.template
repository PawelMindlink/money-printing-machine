# ============================================================
# Money Printing Machine — Environment Variables Template
# ============================================================
# Copy to .env and fill in real values.
# .env is in .gitignore — NEVER commit it.
# This template is safe to commit (no real values).
#
# This .env is also used as the fallback for:
#   Meta Ads Analysis Production Upload/execution/*.py
# ============================================================

# ── n8n Workflow Automation ───────────────────────────────────
# Find at: n8n Settings → Personal Settings → API Keys
N8N_URL=https://your-n8n-instance.example.com
N8N_API_KEY=your_n8n_api_key_here

# ── Meta Ads Marketing API ────────────────────────────────────
# System User token from Meta Business Manager (never expires unless rotated)
# Docs: https://developers.facebook.com/docs/marketing-apis/overview/authentication
META_ACCESS_TOKEN=your_meta_system_user_token_here

# ── Google Analytics 4 ───────────────────────────────────────
# Absolute path to GCP service account JSON file
# Docs: https://developers.google.com/analytics/devguides/reporting/data/v1/quickstart-client-libraries
GA4_CREDS_PATH=C:/path/to/ga4-service-account-credentials.json

# ── Gemini API ────────────────────────────────────────────────
# Used for: C4 image generation (Nano Banana 2), copywriting, deep research
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Anthropic API ─────────────────────────────────────────────
# Used for: Claude-based copywriting and research tasks
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ── Perplexity API ────────────────────────────────────────────
# Used for: deep web research in research workflows
# Get from: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-your_key_here

# ── Product Catalog Feed URLs ─────────────────────────────────
# Security by obscurity — store here to avoid hardcoding in scripts.
IIYAMA_CATALOG_FEED_URL=https://iiyama-sklep.pl/modules/pricewars2/xml/alias/facebook353re3534sdfdfdef.xml
# Add other brand feeds using same pattern:
# BRANDNAME_CATALOG_FEED_URL=https://...
